<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" monitorInterval="30">
    <Properties>
        <Property name="LOG_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</Property>
        <Property name="LOGS_DIR">${sys:LOG_DIR:-logs}</Property>
    </Properties>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${LOG_PATTERN}"/>
        </Console>

        <RollingFile name="RollingFile"
                     fileName="${LOGS_DIR}/inventory-management.log"
                     filePattern="${LOGS_DIR}/inventory-management-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="50MB"/>
            </Policies>
            <DefaultRolloverStrategy max="14"/>
        </RollingFile>

        <!-- Ships structured JSON logs to Better Stack. Defined (and its worker thread
             started) only when LOG_SHIP_TOKEN is set — see LogShippingBootstrap. -->
        <SystemPropertyArbiter propertyName="log.ship.enabled" propertyValue="true">
            <Http name="BetterStack"
                  url="${sys:log.ship.url:-https://in.logs.betterstack.com}"
                  connectTimeoutMillis="4000"
                  readTimeoutMillis="4000">
                <Property name="Authorization" value="Bearer ${sys:log.ship.token:-}"/>
                <JsonTemplateLayout eventTemplateUri="classpath:EcsLayout.json"/>
            </Http>
            <!-- blocking=false: drop logs rather than stall a request if the endpoint is down. -->
            <Async name="BetterStackAsync" bufferSize="1024" blocking="false">
                <AppenderRef ref="BetterStack"/>
            </Async>
        </SystemPropertyArbiter>
    </Appenders>

    <Loggers>
        <!-- Framework noise reduction; app-level verbosity is controlled via
             logging.level.* in application-{profile}.yml -->
        <Logger name="org.hibernate" level="WARN"/>
        <Logger name="org.springframework" level="WARN"/>
        <Logger name="org.apache.catalina" level="WARN"/>
        <Logger name="com.zaxxer.hikari" level="WARN"/>

        <Root level="INFO">
            <AppenderRef ref="Console"/>
            <SpringProfile name="prod">
                <AppenderRef ref="RollingFile"/>
            </SpringProfile>
            <SystemPropertyArbiter propertyName="log.ship.enabled" propertyValue="true">
                <AppenderRef ref="BetterStackAsync"/>
            </SystemPropertyArbiter>
        </Root>
    </Loggers>
</Configuration>
